# Variables d'environnement pour JETC Solution

# ============================================
# Configuration SMTP Infomaniak - Production Ready
# ============================================

# Hôte SMTP Infomaniak
SMTP_HOST=mail.infomaniak.com

# Port SMTP (587 pour STARTTLS)
SMTP_PORT=587

# Identifiants SMTP - Compte Infomaniak
SMTP_USER=contact@jetc-immo.ch
SMTP_PASS=VOTRE_MOT_DE_PASSE_ICI

# Email de l'expéditeur
SMTP_FROM=contact@jetc-immo.ch

# ============================================
# Statistiques (DÉSACTIVÉ par défaut)
# ============================================

# ⚠️ Widget stats désactivé en prod (compteurs non fiables)
# Pour réactiver en dev/local uniquement, décommentez :
# NEXT_PUBLIC_ENABLE_STATS=true

# Configuration Redis (si stats activées)
# UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# ============================================
# Instructions pour la configuration:
# ============================================
# 1. LOCAL: Copiez ce fichier en .env.local (ne pas commit .env.local dans git)
# 2. Remplacez SMTP_PASS par le vrai mot de passe de contact@jetc-immo.ch
# 3. VERCEL: Ajoutez ces variables dans Settings > Environment Variables
# 4. Les emails seront envoyés vers contact@jetc-immo.ch automatiquement
# 5. Un accusé de réception sera envoyé au client automatiquement

