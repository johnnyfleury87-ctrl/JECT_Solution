# Variables d'environnement pour JETC Solution

# Configuration SMTP pour l'envoi d'emails
# Exemple avec Gmail (vous pouvez utiliser d'autres services comme SendGrid, Mailgun, etc.)

# Hôte SMTP
SMTP_HOST=smtp.gmail.com

# Port SMTP (587 pour TLS, 465 pour SSL)
SMTP_PORT=587

# Utiliser SSL (true pour port 465, false pour port 587)
SMTP_SECURE=false

# Identifiants SMTP
# Pour Gmail: utilisez votre email et un "App Password" (https://support.google.com/accounts/answer/185833)
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application

# Email de l'expéditeur (optionnel, utilise SMTP_USER par défaut)
SMTP_FROM=noreply@jetc-solution.com

# Email destinataire pour recevoir les messages du formulaire
MAIL_TO=contact@jetc-solution.com

# Instructions pour la configuration:
# 1. Copiez ce fichier en .env.local (ne pas commit .env.local dans git)
# 2. Remplacez les valeurs par vos vraies credentials
# 3. Pour Gmail, activez l'authentification à 2 facteurs et créez un "App Password"
# 4. Pour d'autres services SMTP, consultez leur documentation

# Alternatives SMTP recommandées:
# - SendGrid: https://sendgrid.com/ (gratuit jusqu'à 100 emails/jour)
# - Mailgun: https://www.mailgun.com/ (gratuit jusqu'à 5000 emails/mois)
# - Amazon SES: https://aws.amazon.com/ses/ (très économique)
# - Resend: https://resend.com/ (moderne et simple)
